{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "r2-file-upload-webhook-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"vars": {
    "WEBHOOK_URL": "https://unbounded-postbox-pretext.ngrok-free.dev/docengine/wherehouse/proposal/webhook",
    "WEBHOOK_SECRET": "polygon_webhook_secret_2026",
    "R2_PUBLIC_URL": "https://pub-ec914cf0c9fc4c6889c1d5a92cf4c6cf.r2.dev"
  },
	"queues": {
		"consumers": [
			{
        "queue": "r2-processing-file-queue",
        "max_batch_size": 5,
        "max_retries": 5, 
        "dead_letter_queue": "r2-failed-webhooks-dlq" 
      }
		],

	},
	"upload_source_maps": true
	/**
